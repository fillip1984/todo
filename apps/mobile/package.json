{
  "name": "mobile",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "build": "pnpm lint",
    "build:interactive": "pnpm lint && pnpm with-env eas build -p ios -e production --local",
    "build:production": "pnpm lint && pnpm with-env eas build -p ios -e production --local --non-interactive",
    "clean": "git clean -xdf .cache .expo  android ios node_modules",
    "ios": "expo run:ios",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path .prettierignore",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "with-env": "dotenv -e ../../.env --",
    "android": "expo run:android"
  },
  "dependencies": {
    "@better-auth/expo": "1.6.23",
    "@expo/ui": "57.0.3",
    "@expo/vector-icons": "^15.0.3",
    "@legendapp/list": "^3.3.1",
    "@tanstack/react-query": "^5.101.2",
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@trpc/tanstack-react-query": "^11.18.0",
    "better-auth": "1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~57.0.2",
    "expo-constants": "~57.0.3",
    "expo-dev-client": "~57.0.5",
    "expo-font": "^57.0.0",
    "expo-linking": "~57.0.1",
    "expo-network": "^57.0.0",
    "expo-router": "~57.0.3",
    "expo-secure-store": "~57.0.0",
    "expo-splash-screen": "~57.0.2",
    "expo-status-bar": "~57.0.0",
    "expo-system-ui": "~57.0.0",
    "expo-web-browser": "~57.0.0",
    "nativewind": "5.0.0-preview.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-native": "~0.86.0",
    "react-native-bouncy-checkbox": "^4.1.4",
    "react-native-css": "3.0.7",
    "react-native-gesture-handler": "~3.0.2",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "~5.8.0",
    "react-native-screens": "~4.25.2",
    "react-native-worklets": "~0.10.1",
    "superjson": "2.2.6",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@todo/api": "workspace:*",
    "@todo/eslint-config": "workspace:*",
    "@todo/prettier-config": "workspace:*",
    "@todo/tsconfig": "workspace:*",
    "@types/react": "19.2.17",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.4",
    "postcss": "^8.5.16",
    "prettier": "^3.9.4",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3"
  },
  "prettier": "@todo/prettier-config",
  "version": "1.0.0"
}
